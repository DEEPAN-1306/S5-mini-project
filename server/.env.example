# Capstone Connect - Backend Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Atlas or Local Connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/capstone_connect?retryWrites=true&w=majority
# Example Local URI: mongodb://localhost:27017/capstone_connect
MONGODB_URI=mongodb://localhost:27017/capstone_connect

# JWT Authentication Secrets
JWT_SECRET=super_secret_university_jwt_key_2026_capstone_connect
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CLIENT_URL=http://localhost:5173

# Optional File Upload Storage Limit (MB)
MAX_FILE_SIZE_MB=10
